generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String   @id @default(uuid()) @db.Uuid
  companyCode      String   @unique @map("company_code") @db.VarChar(50)
  companyName      String   @map("company_name") @db.VarChar(200)
  baseCurrencyCode String   @default("SGD") @map("base_currency_code") @db.VarChar(3)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customers         Customer[]
  projects          Project[]
  suppliers         Supplier[]
  employees         Employee[]
  unitsOfMeasure    UnitOfMeasure[]
  materials         Material[]
  users             User[]
  roles             Role[]
  userRoles         UserRole[]
  approvalWorkflows ApprovalWorkflow[]
  approvalInstances ApprovalInstance[]
  auditLogs         AuditLog[]
  statusDefinitions StatusDefinition[]
  numberSequences   NumberSequence[]
  systemSettings    SystemSetting[]
  costCodes         CostCode[]
  documentTypes     DocumentType[]
  documents         Document[]

  @@map("companies")
}

model Customer {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  customerCode       String   @map("customer_code") @db.VarChar(50)
  customerName       String   @map("customer_name") @db.VarChar(200)
  registrationNumber String?  @map("registration_number") @db.VarChar(100)
  contactName        String?  @map("contact_name") @db.VarChar(200)
  email              String?  @db.VarChar(320)
  phone              String?  @db.VarChar(50)
  address            String?  @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@unique([companyId, customerCode])
  @@index([companyId, isActive])
  @@map("customers")
}

model Supplier {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  supplierCode       String   @map("supplier_code") @db.VarChar(50)
  supplierName       String   @map("supplier_name") @db.VarChar(200)
  registrationNumber String?  @map("registration_number") @db.VarChar(100)
  contactName        String?  @map("contact_name") @db.VarChar(200)
  email              String?  @db.VarChar(320)
  phone              String?  @db.VarChar(50)
  address            String?  @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, supplierCode])
  @@index([companyId, isActive])
  @@map("suppliers")
}

model UnitOfMeasure {
  id            String  @id @default(uuid()) @db.Uuid
  companyId     String  @map("company_id") @db.Uuid
  uomCode       String  @map("uom_code") @db.VarChar(30)
  uomName       String  @map("uom_name") @db.VarChar(100)
  decimalPlaces Int     @default(0) @map("decimal_places")
  isActive      Boolean @default(true) @map("is_active")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  materials Material[]

  @@unique([companyId, uomCode])
  @@index([companyId, isActive])
  @@map("units_of_measure")
}

model Material {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  materialCode     String   @map("material_code") @db.VarChar(80)
  materialName     String   @map("material_name") @db.VarChar(200)
  description      String?  @db.Text
  defaultUomId     String   @map("default_uom_id") @db.Uuid
  materialCategory String?  @map("material_category") @db.VarChar(150)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultUom UnitOfMeasure @relation(fields: [defaultUomId], references: [id], onDelete: Restrict)

  @@unique([companyId, materialCode])
  @@index([companyId, isActive])
  @@index([defaultUomId])
  @@map("materials")
}

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  employeeCode String   @map("employee_code") @db.VarChar(50)
  employeeName String   @map("employee_name") @db.VarChar(200)
  jobTitle     String?  @map("job_title") @db.VarChar(150)
  email        String?  @db.VarChar(320)
  phone        String?  @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user           User?
  projectMembers ProjectMember[]

  @@unique([companyId, employeeCode])
  @@index([companyId, isActive])
  @@map("employees")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  email        String    @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(200)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  sessions        UserSession[]
  approvalActions ApprovalAction[]
  auditLogs       AuditLog[]
  uploadedDocuments Document[]     @relation("DocumentUploader")
  documentLinks     DocumentLink[] @relation("DocumentLinker")

  @@unique([companyId, email])
  @@index([companyId, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  roleCode    String   @map("role_code") @db.VarChar(80)
  roleName    String   @map("role_name") @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles         UserRole[]
  rolePermissions   RolePermission[]
  approvalStepRoles ApprovalStepRole[]

  @@unique([companyId, roleCode])
  @@index([companyId, isActive])
  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid()) @db.Uuid
  permissionCode String   @unique @map("permission_code") @db.VarChar(150)
  moduleCode     String   @map("module_code") @db.VarChar(50)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([moduleCode])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  csrfTokenHash String    @map("csrf_token_hash") @db.VarChar(128)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model ApprovalWorkflow {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  workflowCode String   @map("workflow_code") @db.VarChar(80)
  entityType   String   @map("entity_type") @db.VarChar(100)
  workflowName String   @map("workflow_name") @db.VarChar(150)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  steps     ApprovalStep[]
  instances ApprovalInstance[]

  @@unique([companyId, workflowCode])
  @@index([companyId, entityType, isActive])
  @@map("approval_workflows")
}

model ApprovalStep {
  id                 String @id @default(uuid()) @db.Uuid
  approvalWorkflowId String @map("approval_workflow_id") @db.Uuid
  stepNo             Int    @map("step_no")
  stepName           String @map("step_name") @db.VarChar(150)
  requiredApprovals  Int    @default(1) @map("required_approvals")

  workflow  ApprovalWorkflow @relation(fields: [approvalWorkflowId], references: [id], onDelete: Restrict)
  stepRoles ApprovalStepRole[]
  actions   ApprovalAction[]

  @@unique([approvalWorkflowId, stepNo])
  @@map("approval_steps")
}

model ApprovalStepRole {
  id             String @id @default(uuid()) @db.Uuid
  approvalStepId String @map("approval_step_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  approvalStep ApprovalStep @relation(fields: [approvalStepId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([approvalStepId, roleId])
  @@index([roleId])
  @@map("approval_step_roles")
}

model ApprovalInstance {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  approvalWorkflowId String    @map("approval_workflow_id") @db.Uuid
  entityType         String    @map("entity_type") @db.VarChar(100)
  entityId           String    @map("entity_id") @db.Uuid
  currentStepNo      Int       @map("current_step_no")
  approvalState      String    @map("approval_state") @db.VarChar(30)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workflow ApprovalWorkflow   @relation(fields: [approvalWorkflowId], references: [id], onDelete: Restrict)
  actions  ApprovalAction[]

  @@index([companyId, entityType, entityId])
  @@index([approvalWorkflowId, approvalState])
  @@map("approval_instances")
}

model ApprovalAction {
  id                 String   @id @default(uuid()) @db.Uuid
  approvalInstanceId String   @map("approval_instance_id") @db.Uuid
  approvalStepId     String   @map("approval_step_id") @db.Uuid
  action             String   @db.VarChar(30)
  actionByUserId     String   @map("action_by_user_id") @db.Uuid
  actionAt           DateTime @default(now()) @map("action_at") @db.Timestamptz(6)
  comment            String?  @db.Text

  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  approvalStep     ApprovalStep     @relation(fields: [approvalStepId], references: [id], onDelete: Restrict)
  actionByUser     User             @relation(fields: [actionByUserId], references: [id], onDelete: Restrict)

  @@unique([approvalInstanceId, approvalStepId, actionByUserId])
  @@index([approvalInstanceId, actionAt])
  @@index([actionByUserId])
  @@map("approval_actions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String   @map("entity_id") @db.Uuid
  action        String   @db.VarChar(50)
  actorUserId   String   @map("actor_user_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  correlationId String?  @map("correlation_id") @db.VarChar(128)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUser User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}


model StatusDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  entityType  String  @map("entity_type") @db.VarChar(100)
  statusCode  String  @map("status_code") @db.VarChar(80)
  statusLabel String  @map("status_label") @db.VarChar(150)
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@unique([companyId, entityType, statusCode])
  @@index([companyId, entityType, isActive, sortOrder])
  @@map("status_definitions")
}

model NumberSequence {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @map("company_id") @db.Uuid
  entityType     String  @map("entity_type") @db.VarChar(100)
  sequenceCode   String  @map("sequence_code") @db.VarChar(80)
  formatTemplate String  @map("format_template") @db.VarChar(120)
  resetRule      String  @map("reset_rule") @db.VarChar(30)
  lastPeriodKey  String? @map("last_period_key") @db.VarChar(20)
  nextValue      Int     @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, sequenceCode])
  @@index([companyId, entityType])
  @@map("number_sequences")
}

model SystemSetting {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  settingKey   String @map("setting_key") @db.VarChar(150)
  settingValue Json   @map("setting_value")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, settingKey])
  @@map("system_settings")
}


model Project {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  projectCode        String   @map("project_code") @db.VarChar(50)
  projectName        String   @map("project_name") @db.VarChar(200)
  customerId         String   @map("customer_id") @db.Uuid
  statusDefinitionId String?  @map("status_definition_id") @db.Uuid
  contractValue      Decimal  @map("contract_value") @db.Decimal(18, 2)
  location           String?  @db.VarChar(500)
  description        String?  @db.Text
  plannedStartDate   DateTime @map("planned_start_date") @db.Date
  plannedCompletionDate DateTime @map("planned_completion_date") @db.Date
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  statusDefinition StatusDefinition? @relation(fields: [statusDefinitionId], references: [id], onDelete: Restrict)
  members          ProjectMember[]
  contacts         ProjectContact[]
  wbsElements      WbsElement[]

  @@unique([companyId, projectCode])
  @@index([companyId, isActive])
  @@index([customerId])
  @@index([statusDefinitionId])
  @@map("projects")
}

model ProjectMember {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  projectRole String    @map("project_role") @db.VarChar(150)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([projectId, employeeId, projectRole])
  @@index([projectId, isActive])
  @@index([employeeId, isActive])
  @@map("project_members")
}

model ProjectContact {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  contactName      String   @map("contact_name") @db.VarChar(200)
  organizationName String?  @map("organization_name") @db.VarChar(200)
  roleOrTitle      String?  @map("role_or_title") @db.VarChar(150)
  email            String?  @db.VarChar(320)
  phone            String?  @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, isActive])
  @@map("project_contacts")
}


model WbsElement {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  wbsCode     String   @map("wbs_code") @db.VarChar(80)
  wbsName     String   @map("wbs_name") @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parent   WbsElement?   @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children WbsElement[]  @relation("WbsHierarchy")

  @@unique([projectId, wbsCode])
  @@index([projectId, parentId, isActive])
  @@map("wbs_elements")
}

model CostCode {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  costCode    String   @map("cost_code") @db.VarChar(80)
  costName    String   @map("cost_name") @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, costCode])
  @@index([companyId, isActive])
  @@map("cost_codes")
}


model DocumentType {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  documentTypeCode String   @map("document_type_code") @db.VarChar(80)
  documentTypeName String   @map("document_type_name") @db.VarChar(150)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents Document[]

  @@unique([companyId, documentTypeCode])
  @@index([companyId, isActive])
  @@map("document_types")
}

model Document {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  documentTypeId   String   @map("document_type_id") @db.Uuid
  fileName         String   @map("file_name") @db.VarChar(255)
  storageProvider  String   @map("storage_provider") @db.VarChar(30)
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(255)
  fileSizeBytes    Int      @map("file_size_bytes")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  checksum         String?  @db.VarChar(64)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  links        DocumentLink[]

  @@index([companyId, isActive, uploadedAt])
  @@index([documentTypeId])
  @@index([uploadedByUserId])
  @@map("documents")
}

model DocumentLink {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String   @map("entity_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  linkedByUserId String   @map("linked_by_user_id") @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  linkedBy User     @relation("DocumentLinker", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([linkedByUserId])
  @@map("document_links")
}
