generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String   @id @default(uuid()) @db.Uuid
  companyCode      String   @unique @map("company_code") @db.VarChar(50)
  companyName      String   @map("company_name") @db.VarChar(200)
  baseCurrencyCode String   @default("SGD") @map("base_currency_code") @db.VarChar(3)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees         Employee[]
  users             User[]
  roles             Role[]
  userRoles         UserRole[]
  approvalWorkflows ApprovalWorkflow[]
  approvalInstances ApprovalInstance[]
  auditLogs         AuditLog[]

  @@map("companies")
}

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  employeeCode String   @map("employee_code") @db.VarChar(50)
  employeeName String   @map("employee_name") @db.VarChar(200)
  jobTitle     String?  @map("job_title") @db.VarChar(150)
  email        String?  @db.VarChar(320)
  phone        String?  @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User?

  @@unique([companyId, employeeCode])
  @@index([companyId, isActive])
  @@map("employees")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  email        String    @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(200)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  sessions        UserSession[]
  approvalActions ApprovalAction[]
  auditLogs       AuditLog[]

  @@unique([companyId, email])
  @@index([companyId, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  roleCode    String   @map("role_code") @db.VarChar(80)
  roleName    String   @map("role_name") @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles         UserRole[]
  rolePermissions   RolePermission[]
  approvalStepRoles ApprovalStepRole[]

  @@unique([companyId, roleCode])
  @@index([companyId, isActive])
  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid()) @db.Uuid
  permissionCode String   @unique @map("permission_code") @db.VarChar(150)
  moduleCode     String   @map("module_code") @db.VarChar(50)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([moduleCode])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  csrfTokenHash String    @map("csrf_token_hash") @db.VarChar(128)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model ApprovalWorkflow {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  workflowCode String   @map("workflow_code") @db.VarChar(80)
  entityType   String   @map("entity_type") @db.VarChar(100)
  workflowName String   @map("workflow_name") @db.VarChar(150)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  steps     ApprovalStep[]
  instances ApprovalInstance[]

  @@unique([companyId, workflowCode])
  @@index([companyId, entityType, isActive])
  @@map("approval_workflows")
}

model ApprovalStep {
  id                 String @id @default(uuid()) @db.Uuid
  approvalWorkflowId String @map("approval_workflow_id") @db.Uuid
  stepNo             Int    @map("step_no")
  stepName           String @map("step_name") @db.VarChar(150)
  requiredApprovals  Int    @default(1) @map("required_approvals")

  workflow  ApprovalWorkflow @relation(fields: [approvalWorkflowId], references: [id], onDelete: Restrict)
  stepRoles ApprovalStepRole[]
  actions   ApprovalAction[]

  @@unique([approvalWorkflowId, stepNo])
  @@map("approval_steps")
}

model ApprovalStepRole {
  id             String @id @default(uuid()) @db.Uuid
  approvalStepId String @map("approval_step_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  approvalStep ApprovalStep @relation(fields: [approvalStepId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([approvalStepId, roleId])
  @@index([roleId])
  @@map("approval_step_roles")
}

model ApprovalInstance {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  approvalWorkflowId String    @map("approval_workflow_id") @db.Uuid
  entityType         String    @map("entity_type") @db.VarChar(100)
  entityId           String    @map("entity_id") @db.Uuid
  currentStepNo      Int       @map("current_step_no")
  approvalState      String    @map("approval_state") @db.VarChar(30)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workflow ApprovalWorkflow   @relation(fields: [approvalWorkflowId], references: [id], onDelete: Restrict)
  actions  ApprovalAction[]

  @@index([companyId, entityType, entityId])
  @@index([approvalWorkflowId, approvalState])
  @@map("approval_instances")
}

model ApprovalAction {
  id                 String   @id @default(uuid()) @db.Uuid
  approvalInstanceId String   @map("approval_instance_id") @db.Uuid
  approvalStepId     String   @map("approval_step_id") @db.Uuid
  action             String   @db.VarChar(30)
  actionByUserId     String   @map("action_by_user_id") @db.Uuid
  actionAt           DateTime @default(now()) @map("action_at") @db.Timestamptz(6)
  comment            String?  @db.Text

  approvalInstance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  approvalStep     ApprovalStep     @relation(fields: [approvalStepId], references: [id], onDelete: Restrict)
  actionByUser     User             @relation(fields: [actionByUserId], references: [id], onDelete: Restrict)

  @@unique([approvalInstanceId, approvalStepId, actionByUserId, action])
  @@index([approvalInstanceId, actionAt])
  @@index([actionByUserId])
  @@map("approval_actions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String   @map("entity_id") @db.Uuid
  action        String   @db.VarChar(50)
  actorUserId   String   @map("actor_user_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  correlationId String?  @map("correlation_id") @db.VarChar(128)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUser User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}
