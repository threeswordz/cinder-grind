model Activity {
  id                      String   @id @default(uuid()) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  wbsId                   String   @map("wbs_id") @db.Uuid
  parentActivityId        String?  @map("parent_activity_id") @db.Uuid
  activityTypeId          String?  @map("activity_type_id") @db.Uuid
  workingCalendarId       String   @map("working_calendar_id") @db.Uuid
  statusDefinitionId      String?  @map("status_definition_id") @db.Uuid
  activityCode            String   @map("activity_code") @db.VarChar(80)
  activityName            String   @map("activity_name") @db.VarChar(200)
  description             String?  @db.Text
  isSummary               Boolean  @default(false) @map("is_summary")
  isMilestone             Boolean  @default(false) @map("is_milestone")
  plannedDurationWorkDays Decimal  @map("planned_duration_work_days") @db.Decimal(8, 2)
  plannedStartDate        DateTime @map("planned_start_date") @db.Date
  plannedFinishDate       DateTime @map("planned_finish_date") @db.Date
  actualStartDate         DateTime? @map("actual_start_date") @db.Date
  actualFinishDate        DateTime? @map("actual_finish_date") @db.Date
  forecastStartDate       DateTime? @map("forecast_start_date") @db.Date
  forecastFinishDate      DateTime? @map("forecast_finish_date") @db.Date
  responsibleEmployeeId   String?  @map("responsible_employee_id") @db.Uuid
  ownerUserId             String?  @map("owner_user_id") @db.Uuid
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  wbs                 WbsElement        @relation(fields: [wbsId], references: [id], onDelete: Restrict)
  parent              Activity?         @relation("ActivityHierarchy", fields: [parentActivityId], references: [id], onDelete: Restrict)
  children            Activity[]        @relation("ActivityHierarchy")
  activityType        ActivityType?     @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  workingCalendar     WorkingCalendar   @relation(fields: [workingCalendarId], references: [id], onDelete: Restrict)
  statusDefinition    StatusDefinition? @relation(fields: [statusDefinitionId], references: [id], onDelete: Restrict)
  responsibleEmployee Employee?         @relation(fields: [responsibleEmployeeId], references: [id], onDelete: Restrict)
  owner               User?             @relation("ActivityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  predecessorLinks    ActivityDependency[] @relation("ActivityPredecessor")
  successorLinks      ActivityDependency[] @relation("ActivitySuccessor")
  baselineSnapshots   ScheduleBaselineActivity[]
  progressHistory     ActivityProgress[]
  dailySiteReportMaterialUsage DailySiteReportMaterialUsage[]
  dailySiteReportProgressLines DailySiteReportProgressLine[]
  dailySiteReportIssues        DailySiteReportIssue[]
  dailySiteReportDelays        DailySiteReportDelay[]
  dailySiteReportInspections   DailySiteReportInspection[]

  @@unique([projectId, activityCode])
  @@index([companyId, projectId, isActive])
  @@index([projectId, wbsId])
  @@index([projectId, parentActivityId])
  @@index([workingCalendarId])
  @@index([plannedStartDate, plannedFinishDate])
  @@map("activities")
}

model ActivityDependency {
  id                    String   @id @default(uuid()) @db.Uuid
  projectId             String   @map("project_id") @db.Uuid
  predecessorActivityId String   @map("predecessor_activity_id") @db.Uuid
  successorActivityId   String   @map("successor_activity_id") @db.Uuid
  dependencyType        String   @map("dependency_type") @db.VarChar(2)
  lagWorkDays           Decimal  @default(0) @map("lag_work_days") @db.Decimal(8, 2)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  predecessor Activity @relation("ActivityPredecessor", fields: [predecessorActivityId], references: [id], onDelete: Restrict)
  successor   Activity @relation("ActivitySuccessor", fields: [successorActivityId], references: [id], onDelete: Restrict)

  @@unique([predecessorActivityId, successorActivityId, dependencyType])
  @@index([projectId, isActive])
  @@index([successorActivityId])
  @@map("activity_dependencies")
}



