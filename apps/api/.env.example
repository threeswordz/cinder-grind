# Local development only. Do not commit a real .env file.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://construction_erp:construction_erp_dev_only@localhost:5432/construction_erp?schema=public
STORAGE_ROOT=../../storage
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# One-time local/environment bootstrap values.
# Never commit a real BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_COMPANY_CODE=DEMO
BOOTSTRAP_COMPANY_NAME=Example Construction Company
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
