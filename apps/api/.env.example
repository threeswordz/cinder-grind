# Local development only. Do not commit a real .env file.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://construction_erp:construction_erp_dev_only@localhost:5432/construction_erp?schema=public
STORAGE_ROOT=../../storage
DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,text/csv,application/msword,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
REQUEST_BODY_MAX_BYTES=1048576
TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
OPENAPI_ENABLED=false

# One-time local/environment bootstrap values.
# Never commit a real BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_COMPANY_CODE=DEMO
BOOTSTRAP_COMPANY_NAME=Example Construction Company
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
