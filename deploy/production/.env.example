# V1.0 Production deployment template.
# Copy this file to deploy/production/.env OUTSIDE version control or provide the
# same values through your host/process manager. Never commit real credentials.

NODE_ENV=production
RELEASE_COMMIT=0000000000000000000000000000000000000000

# The API is expected to sit behind an HTTPS reverse proxy. Loopback is the
# safest single-host default; an internal container/network address is also
# valid when the operator explicitly controls that boundary.
API_HOST=127.0.0.1
API_PORT=3000

# Public browser origin. Production requires HTTPS.
WEB_ORIGIN=https://erp.example.com

# Build the React client for same-origin API access through the reverse proxy.
VITE_API_BASE_URL=/api/v1

# Supply the real database credential outside Git.
DATABASE_URL=postgresql://construction_erp:replace-with-production-secret@db.example.internal:5432/construction_erp?schema=public

# Use an absolute, access-controlled persistent path.
STORAGE_ROOT=/srv/construction-erp/documents

DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,text/csv,application/msword,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
