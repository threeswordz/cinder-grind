{
  "name": "construction-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate": "pnpm typecheck && pnpm test && pnpm build",
    "dev:web": "pnpm --filter @construction-erp/web dev",
    "build:api": "pnpm --filter @construction-erp/api build",
    "start:api": "pnpm --filter @construction-erp/api start",
    "prisma:generate": "pnpm --filter @construction-erp/api prisma:generate",
    "prisma:validate": "pnpm --filter @construction-erp/api prisma:validate",
    "prisma:migrate:dev": "pnpm --filter @construction-erp/api prisma:migrate:dev"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
